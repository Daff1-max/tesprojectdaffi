{
  "name": "flood-jgc",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w apps/api",
    "lint": "eslint apps/*/src --ext .ts,.tsx",
    "generate:data": "npx tsx scripts/generate-demo-data.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.4.5",
    "tsx": "^4.7.3"
  }
}
